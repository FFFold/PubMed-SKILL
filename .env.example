# NCBI API Key
# Get yours at: https://www.ncbi.nlm.nih.gov/account/settings/
# Without a key: 3 requests/sec. With a key: 10 requests/sec.
#
# The script resolves the key in this order:
#   1. --api-key CLI argument
#   2. NCBI_API_KEY environment variable
#   3. EUTILS_API_KEY environment variable
#   4. API_KEY environment variable
#   5. .env files (cwd → skill root → ~/.pubmed/.env)

NCBI_API_KEY="your-ncbi-api-key-here"
